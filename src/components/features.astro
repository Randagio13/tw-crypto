---
import { Icon } from 'astro-icon/components'
import ContentSection from '~/components/content-section.astro'
import type { FeatureItem } from '~/types'

const features: Array<FeatureItem> = [
  {
    title: 'Update watchlist',
    description:
      "Every 2 weeks, we'll update our watchlists with the latest cryptocurrencies.",
    icon: 'mdi:update',
  },
  {
    title: 'Import watchlist',
    description:
      'Download and import your watchlist from your favorite exchange and start tracking your favorite cryptocurrencies on TradingView.',
    icon: 'mdi:import',
  },
  // {
  //   title: 'On-Demand Components',
  //   description:
  //     'Need some JS? Astro can automatically hydrate interactive components when they become visible on the page. If the user never sees it, they never load it.',
  //   icon: 'mdi:directions-fork',
  // },
  // {
  //   title: 'Broad Integration',
  //   description:
  //     'Astro supports TypeScript, Scoped CSS, CSS Modules, Sass, Tailwind, Markdown, MDX, and any of your favorite npm packages.',
  //   icon: 'mdi:graph',
  // },
  {
    title: 'Multiple Exchanges',
    description:
      'Find your exchange, download your watchlist, and start tracking your favorite cryptocurrencies.',
    icon: 'mdi:exchange',
  },
  {
    title: 'Community',
    description:
      'TradingView Crypto is a open source project, and we welcome contributions or support from everyone.',
    icon: 'mdi:account-group',
  },
]
---

<ContentSection title="Features" id="features">
  <Fragment slot="lead">
    Born to help <span class="text-primary">crypto traders</span> track their
    <span class="text-primary">favorite</span> cryptocurrencies.
  </Fragment>
  <ul class="grid max-w-6xl grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
    {
      features.map(({ title, description, icon }) => (
        <li class="flex flex-col items-center gap-4 border border-default bg-offset p-6">
          <div class="size-16 rounded-full border-2 border-current p-3">
            <Icon name={icon} class="size-full" />
          </div>
          <p class="text-center font-extrabold text-xl">{title}</p>
          <p class="text-center text-offset text-sm">{description}</p>
        </li>
      ))
    }
  </ul>
</ContentSection>
