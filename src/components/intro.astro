---
import { Icon } from 'astro-icon/components'
import ContentSection from '~/components/content-section.astro'
---

<ContentSection title="Download your crypto watchlist" id="intro">
  <Icon slot="eyebrow" name="tw/tw-crypto-black" class="h-1/2 w-64" />
  <Fragment slot="lead">
    Find your <span class="text-primary">exchange</span>, download your <span
      class="text-primary">watchlist</span
    >, and start tracking your favorite <span class="text-primary"
      >cryptocurrencies</span
    >.
  </Fragment>
  <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
    <a
      href="https://docs.astro.build/"
      class="flex items-center justify-center gap-3 border-2 border-current px-6 py-4"
    >
      <Icon name="mdi:heart" class="size-8" />
      <span>Donate</span>
    </a>
    <a
      href="https://astro.new/"
      class="flex items-center justify-center gap-3 border-2 border-current px-6 py-4"
    >
      <Icon name="mdi:rocket" class="size-8" />
      <span>Try it out</span>
    </a>
  </div>
</ContentSection>
