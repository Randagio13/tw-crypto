---
import CompatibilityList from '~/components/compatibility-list.astro'
import ContentSection from '~/components/content-section.astro'
import type { CompatibilityItem } from '~/types'

const exchanges: Array<CompatibilityItem> = [
  {
    title: 'Binance',
    icon: 'exchanges/binance',
    url: 'https://binance.com/',
  },
  {
    title: 'Bybit',
    icon: 'exchanges/bybit',
    url: 'https://bybit.com/',
  },
  {
    title: 'Coinbase',
    icon: 'exchanges/coinbase',
    url: 'https://coinbase.com/',
  },
  {
    title: 'Kraken',
    icon: 'exchanges/kraken',
    url: 'https://kraken.com/',
  },
  {
    title: 'KuCoin',
    icon: 'exchanges/kucoin',
    url: 'https://www.kucoin.com/',
  },
  {
    title: 'Bitget',
    icon: 'exchanges/bitget',
    url: 'https://bitget.com/',
  },
]
---

<ContentSection title="Exchanges" id="exchanges">
  <Fragment slot="lead">
    Find your favorite <span class="text-primary">exchange</span>. Download your <span
      class="text-primary">watchlist</span
    >, and start tracking your favorite <span class="text-primary"
      >cryptocurrencies</span
    >.
  </Fragment>
  <CompatibilityList items={exchanges} title="Exchanges" />
</ContentSection>
